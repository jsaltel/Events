export default function EventsList() {
  const [activeTab, setActiveTab] = useState('discover');
  const [modalVisible, setModalVisible] = useState(false);
  const [selectedEvent, setSelectedEvent] = useState(null);
  const slideAnim = useState(new Animated.Value(0))[0];

  const showModal = (event) => {
    setSelectedEvent(event);
    setModalVisible(true);
    Animated.spring(slideAnim, {
      toValue: 1,
      useNativeDriver: true,
      tension: 65,
      friction: 11,
    }).start();
  };

  const hideModal = () => {
    Animated.timing(slideAnim, {
      toValue: 0,
      duration: 200,
      useNativeDriver: true,
    }).start(() => {
      setModalVisible(false);
      setSelectedEvent(null);
    });
  };

  const renderAttendees = (attendees, totalAttendees) => {
    return (
      <View style={styles.attendeesContainer}>
        {attendees.map((attendee, index) => (
          <Image
            key={attendee.id}
            source={{ uri: attendee.avatar }}
            style={[
              styles.attendeeAvatar,
              { right: index * 15 }
            ]}
          />
        ))}
        {totalAttendees > attendees.length && (
          <View style={[styles.attendeeCount, { right: attendees.length * 15 }]}>
            <Text style={styles.attendeeCountText}>+{totalAttendees - attendees.length}</Text>
          </View>
        )}
      </View>
    );
  };

  const renderEventCard = ({ item }) => (
    <TouchableOpacity 
      activeOpacity={0.95} 
      onPress={() => showModal(item)}
      style={styles.cardContainer}
    >
      <View style={styles.card}>
        <Image
          source={{ uri: item.image }}
          style={styles.cardImage}
        />
        <LinearGradient
          colors={['rgba(0,0,0,0)', 'rgba(0,0,0,0.8)']}
          style={styles.gradient}
        />
        <View style={styles.cardContent}>
          <Text style={styles.title} numberOfLines={1}>{item.title}</Text>
          <View style={styles.infoRow}>
            <View style={styles.infoContainer}>
              <MaterialIcons name="event" size={14} color="#fff" />
              <Text style={styles.infoText}>{item.date}</Text>
            </View>
            <View style={styles.infoContainer}>
              <MaterialIcons name="access-time" size={14} color="#fff" />
              <Text style={styles.infoText}>{item.time}</Text>
            </View>
          </View>
          {renderAttendees(item.attendees, item.totalAttendees)}
        </View>
      </View>
    </TouchableOpacity>
  );

  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <View style={styles.tabContainer}>
          <TouchableOpacity 
            style={[styles.tab, activeTab === 'discover' && styles.activeTab]} 
            onPress={() => setActiveTab('discover')}
          >
            <Text style={[styles.tabText, activeTab === 'discover' && styles.activeTabText]}>
              Discover
            </Text>
          </TouchableOpacity>
          <TouchableOpacity 
            style={[styles.tab, activeTab === 'myEvents' && styles.activeTab]} 
            onPress={() => setActiveTab('myEvents')}
          >
            <Text style={[styles.tabText, activeTab === 'myEvents' && styles.activeTabText]}>
              My Events
            </Text>
          </TouchableOpacity>
        </View>
      </View>

      <FlatList
        data={eventsData}
        renderItem={renderEventCard}
        keyExtractor={(item) => item.id}
        showsVerticalScrollIndicator={false}
        contentContainerStyle={styles.listContainer}
      />

      <Modal
        visible={modalVisible}
        transparent={true}
        animationType="fade"
        onRequestClose={hideModal}
      >
        <TouchableOpacity
          style={styles.modalOverlay}
          activeOpacity={1}
          onPress={hideModal}
        >
          {selectedEvent && (
            <Animated.View
              style={[
                styles.modalContent,
                {
                  transform: [
                    {
                      translateY: slideAnim.interpolate({
                        inputRange: [0, 1],
                        outputRange: [600, 0],
                      }),
                    },
                  ],
                },
              ]}
            >
              <View style={styles.modalHeader}>
                <View style={styles.modalIndicator} />
              </View>
              <ScrollView style={styles.modalScroll}>
                <Image
                  source={{ uri: selectedEvent.image }}
                  style={styles.modalImage}
                />
                <View style={styles.modalBody}>
                  <Text style={styles.modalTitle}>{selectedEvent.title}</Text>
                  
                  <View style={styles.modalInfoRow}>
                    <MaterialIcons name="event" size={20} color="#666" />
                    <Text style={styles.modalInfoText}>{selectedEvent.date}</Text>
                  </View>
                  
                  <View style={styles.modalInfoRow}>
                    <MaterialIcons name="access-time" size={20} color="#666" />
                    <Text style={styles.modalInfoText}>{selectedEvent.time}</Text>
                  </View>
                  
                  <View style={styles.modalInfoRow}>
                    <Ionicons name="location-outline" size={20} color="#666" />
                    <Text style={styles.modalInfoText}>{selectedEvent.location}</Text>
                  </View>

                  <Text style={styles.modalSectionTitle}>About</Text>
                  <Text style={styles.modalDescription}>{selectedEvent.description}</Text>

                  <Text style={styles.modalSectionTitle}>Attendees</Text>
                  {renderAttendees(selectedEvent.attendees, selectedEvent.totalAttendees)}
                </View>
              </ScrollView>
              
              <TouchableOpacity 
                style={styles.joinButton}
                onPress={hideModal}
              >
                <Text style={styles.joinButtonText}>Join Event</Text>
              </TouchableOpacity>
            </Animated.View>
          )}
        </TouchableOpacity>
      </Modal>
    </View>
  );
}

